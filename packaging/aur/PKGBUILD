# Maintainer: Tarcísio Pedro <tarcisiopgs@gmail.com>
pkgname=devsweep-bin
pkgver=0.4.1
pkgrel=1
pkgdesc="Find and remove what a developer's machine accumulates: build artifacts, agent worktrees, emulators, Docker leftovers and dev caches"
arch=('x86_64' 'aarch64')
url="https://github.com/tarcisiopgs/devsweep"
license=('MIT')
provides=('devsweep')
conflicts=('devsweep')
# The release binary is static and already stripped.
options=('!strip' '!debug')
source_x86_64=("devsweep-$pkgver-x86_64.tar.xz::$url/releases/download/v$pkgver/devsweep-x86_64-unknown-linux-musl.tar.xz")
source_aarch64=("devsweep-$pkgver-aarch64.tar.xz::$url/releases/download/v$pkgver/devsweep-aarch64-unknown-linux-musl.tar.xz")
sha256sums_x86_64=('7a08e200ef8ac15dcc3b35cddfa41731d98b2a361cf9ae4bf9cbe3a09e588a19')
sha256sums_aarch64=('6621df136e8f526c2f53554b1029f4f10eb8fdf0e2d39a620cf8f88a6f5b9442')

package() {
  cd "$srcdir/devsweep-$CARCH-unknown-linux-musl"
  install -Dm755 devsweep "$pkgdir/usr/bin/devsweep"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
