  "description": "Find and remove what a developer's machine accumulates: build artifacts, agent worktrees, simulators, emulators, Docker leftovers and dev caches.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarcisiopgs/devsweep.git"
  },
