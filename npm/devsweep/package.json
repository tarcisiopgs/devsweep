  },
  "optionalDependencies": {
    "devsweep-darwin-arm64": "0.0.0",
    "devsweep-darwin-x64": "0.0.0",
    "devsweep-linux-arm64": "0.0.0",
    "devsweep-linux-x64": "0.0.0"
